{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Firmware",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Start pyOCD GDB Server",
      "type": "shell",
      "command": "${env:APPDATA}\\Python\\Python313\\Scripts\\pyocd.exe",
      "args": ["gdbserver", "--target", "stm32f429xi"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*\\b[Ee]rror\\b.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*gdbserver.*",
          "endsPattern": "GDB server listening on port 3333"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Clear-Display Firmware",
      "type": "shell",
      "command": "make",
      "args": ["clear"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Erase Board",
      "type": "shell",
      "command": "arm-none-eabi-gdb",
      "args": [
        "-q",
        "-batch",
        "-ex", "set remotetimeout 300",
        "-ex", "target extended-remote localhost:3333",
        "-ex", "monitor reset halt",
        "-ex", "monitor erase",
        "-ex", "monitor reset halt",
        "-ex", "monitor erase",
        "-ex", "monitor reset halt",
        "-ex", "file build-clear/clear-display.elf",
        "-ex", "load",
        "-ex", "monitor reset",
        "-ex", "detach"
      ],
      "dependsOrder": "sequence",
      "dependsOn": ["Build Clear-Display Firmware", "Start pyOCD GDB Server"],
      "problemMatcher": []
    },
    {
      "label": "Commit and Push to Private Repository",
      "type": "shell",
      "command": "if ((git remote) -contains 'origin') { git remote rename origin upstream }; if (-not ((git remote) -contains 'private')) { git remote add private '${input:privateRepositoryUrl}' }; if (-not ((git remote) -contains 'public')) { git remote add public 'https://github.com/rkkarat/32f429idiscovery-bsp.git' }; make; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git add -A; git commit -m '${input:commitMessage}'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git push -u private ${input:branchName}",
      "problemMatcher": []
    },
    {
      "label": "Push to Public Repository",
      "type": "shell",
      "command": "if (-not ((git remote) -contains 'public')) { git remote add public 'https://github.com/rkkarat/32f429idiscovery-bsp.git' }; git push -u public ${input:branchName}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "privateRepositoryUrl",
      "type": "promptString",
      "description": "Private repository URL",
      "password": false
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "Fix touch menu reliability and finalize LCD demo"
    },
    {
      "id": "branchName",
      "type": "promptString",
      "description": "Branch to push",
      "default": "freertos-lcd-demo"
    }
  ]
}
