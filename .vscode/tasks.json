{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Firmware",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Start pyOCD GDB Server",
      "type": "shell",
      "command": "${env:APPDATA}\\Python\\Python313\\Scripts\\pyocd.exe",
      "args": ["gdbserver", "--target", "stm32f429xi"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*\\b[Ee]rror\\b.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*gdbserver.*",
          "endsPattern": "GDB server listening on port 3333"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Debug Firmware in Terminal (GDB)",
      "type": "process",
      "command": "arm-none-eabi-gdb",
      "windows": {
        "command": "C:\\ST\\STM32CubeIDE_2.2.0\\STM32CubeIDE\\plugins\\com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740\\tools\\bin\\arm-none-eabi-gdb.exe"
      },
      "args": [
        "-q",
        "build/stm32F429freertos-lcd-demo.elf",
        "-ex", "target extended-remote 127.0.0.1:3333"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOrder": "sequence",
      "dependsOn": ["Build Firmware", "Start pyOCD GDB Server"],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Build Clear-Display Firmware",
      "type": "shell",
      "command": "make",
      "args": ["clear"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Erase Board",
      "type": "shell",
      "command": "arm-none-eabi-gdb",
      "args": [
        "-q",
        "-batch",
        "-ex", "set remotetimeout 300",
        "-ex", "target extended-remote localhost:3333",
        "-ex", "monitor reset halt",
        "-ex", "monitor erase",
        "-ex", "monitor reset halt",
        "-ex", "monitor erase",
        "-ex", "monitor reset halt",
        "-ex", "file build-clear/clear-display.elf",
        "-ex", "load",
        "-ex", "monitor reset",
        "-ex", "detach"
      ],
      "dependsOrder": "sequence",
      "dependsOn": ["Build Clear-Display Firmware", "Start pyOCD GDB Server"],
      "problemMatcher": []
    },
    {
      "label": "Commit and Push to Private Repository",
      "type": "shell",
      "command": "$publicUrl = '${input:publicRepositoryUrl}'; if ((git remote) -contains 'origin') { git remote rename origin upstream }; if (-not ((git remote) -contains 'private')) { git remote add private '${input:privateRepositoryUrl}' }; if ((git remote) -contains 'public') { git remote set-url public $publicUrl } else { git remote add public $publicUrl }; make; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git add -A; git commit -m '${input:commitMessage}'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git push -u private ${input:branchName}",
      "problemMatcher": []
    },
    {
      "label": "Push to Public Repository",
      "type": "shell",
      "command": "$publicUrl = '${input:publicRepositoryUrl}'; if ((git remote) -contains 'public') { git remote set-url public $publicUrl } else { git remote add public $publicUrl }; git push -u public ${input:branchName}",
      "problemMatcher": []
    },
    {
      "label": "Fetch Current Public Repository",
      "type": "shell",
      "command": "$publicUrl = '${input:publicRepositoryUrl}'; if ((git remote) -contains 'public') { git remote set-url public $publicUrl } else { git remote add public $publicUrl }; git fetch public ${input:branchName}; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; git merge --ff-only public/${input:branchName}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "privateRepositoryUrl",
      "type": "promptString",
      "description": "Private repository URL",
      "password": false
    },
    {
      "id": "publicRepositoryUrl",
      "type": "promptString",
      "description": "Public repository URL",
      "default": "https://github.com/rkkarat/32f429idiscovery-bsp.git",
      "password": false
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "Fix touch menu reliability and finalize LCD demo"
    },
    {
      "id": "branchName",
      "type": "promptString",
      "description": "Branch to push",
      "default": "freertos-lcd-demo"
    }
  ]
}
